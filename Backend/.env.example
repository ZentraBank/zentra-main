NODE_ENV=development
PORT=5000
APP_NAME=ZentraBank API
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
SUPERADMIN_FRONTEND_URL=http://localhost:3001
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zentrabank
DB_CONNECTION_LIMIT=10
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
DEFAULT_TENANT_NAME=ZentraBank
DEFAULT_TENANT_SLUG=zentra-bank
DEFAULT_TENANT_DOMAIN=
PLATFORM_ADMIN_FIRST_NAME=Platform
PLATFORM_ADMIN_LAST_NAME=Admin
PLATFORM_ADMIN_EMAIL=platform-admin@example.com
PLATFORM_ADMIN_PASSWORD=ReplaceThisPassword123!
TENANT_ADMIN_FIRST_NAME=Tenant
TENANT_ADMIN_LAST_NAME=Admin
TENANT_ADMIN_EMAIL=tenant-admin@example.com
TENANT_ADMIN_PASSWORD=ReplaceThisPassword123!
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_API_VERSION=v25.0
PAYMENT_MODE=simulation
